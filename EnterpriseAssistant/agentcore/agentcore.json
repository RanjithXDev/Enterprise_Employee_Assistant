{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "EnterpriseAssistant",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "EnterpriseAssistant"
  },
  "runtimes": [
    {
      "name": "EnterpriseAssistant",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/EnterpriseAssistant/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "requestHeaderAllowlist": [
        "Authorization"
      ],
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "https://cognito-idp.ap-south-1.amazonaws.com/ap-south-1_T86CfXMhC/.well-known/openid-configuration",
          "allowedClients": [
            "228vq570b9j3di3qjb00hsnsc7"
          ]
        }
      }
    }
  ],
  "memories": [
    {
      "name": "EnterpriseAssistantMemory",
      "eventExpiryDuration": 30,
      "strategies": [
        {
          "type": "SEMANTIC",
          "namespaceTemplates": [
            "/users/{actorId}/facts"
          ]
        },
        {
          "type": "USER_PREFERENCE",
          "namespaceTemplates": [
            "/users/{actorId}/preferences"
          ]
        },
        {
          "type": "SUMMARIZATION",
          "namespaceTemplates": [
            "/summaries/{actorId}/{sessionId}"
          ]
        },
        {
          "type": "EPISODIC",
          "namespaceTemplates": [
            "/episodes/{actorId}/{sessionId}"
          ],
          "reflectionNamespaceTemplates": [
            "/episodes/{actorId}"
          ]
        }
      ]
    }
  ],
  "knowledgeBases": [],
  "credentials": [
    {
      "authorizerType": "ApiKeyCredentialProvider",
      "name": "EnterpriseAssistantGemini"
    }
  ],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "EnterpriseAssistantGateway",
      "protocolType": "MCP",
      "description": "Gateway for EnterpriseAssistantGateway",
      "targets": [
        {
          "name": "ITTicketTarget",
          "targetType": "lambdaFunctionArn",
          "lambdaFunctionArn": {
            "lambdaArn": "arn:aws:lambda:ap-south-1:202233310639:function:EnterpriseAssistant-ITTicketLambda",
            "toolSchemaFile": "agentcore/schemas/it_ticket_tools.json"
          }
        }
      ],
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "https://cognito-idp.ap-south-1.amazonaws.com/ap-south-1_T86CfXMhC/.well-known/openid-configuration",
          "allowedClients": [
            "228vq570b9j3di3qjb00hsnsc7"
          ]
        }
      },
      "enableSemanticSearch": true,
      "exceptionLevel": "NONE"
    }
  ],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}